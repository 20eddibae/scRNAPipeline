# One hackathon gateway key can back both providers.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://gateway.example.com

# Or set them separately (these win over the gateway fallback).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=

# Models
CLAUDE_MODEL=claude-opus-5
JEV_MODEL=jev-latest

# Offline switches: run the pipeline with no API calls at all.
JEV_OFFLINE=0
CLAUDE_OFFLINE=0
