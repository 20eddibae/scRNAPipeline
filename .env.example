# Put the real values in a file OUTSIDE the repo, e.g.
# ~/.config/modal-hackathon/ai-gateway.env (chmod 600). scripts/serve_local.sh
# reads that file (or $KRINO_ENV_FILE); a local .env also works and is
# gitignored, but keeping no key file in the working tree is the safer habit.
# Never put a real key in THIS file.

# --- Jev (TypeSafe System One) via the Vercel AI Gateway ---
# The Vercel key IS the TypeSafe key. The SDK appends /v1/systemone to the base.
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe

# --- Claude ---
# First-party Anthropic key. To route Claude through a gateway instead, set
# ANTHROPIC_BASE_URL as well -- AI_GATEWAY_API_KEY is only used for Claude when
# a base URL says a gateway is deliberately in the path.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# Required when the key is not scoped to a workspace -- without it every call
# returns a 400 asking for the anthropic-workspace-id header.
# ANTHROPIC_WORKSPACE_ID=

# --- Models ---
CLAUDE_MODEL=claude-opus-5
JEV_MODEL=jev-latest

# --- Offline switches: run the whole pipeline with no API calls at all ---
JEV_OFFLINE=0
CLAUDE_OFFLINE=0

# Below this Jev confidence the step's declared default is used instead.
JEV_CONFIDENCE_FLOOR=0.55
